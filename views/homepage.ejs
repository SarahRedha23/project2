<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>BookShelf</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('./partials/navbar.ejs') %>

    <main class="home-page">

        <section class="hero">

            <div class="hero-content">

                <h1>
                    WELCOME TO<br>
                    BOOKSHELF
                </h1>

                <p>
                    Your place to discover, review,
                    and share great books.
                </p>

                <div class="hero-buttons">

                    <a href="/books" class="hero-button">
                        Browse Books
                    </a>

                    <% if (user) { %>

                        <a href="/books/new" class="hero-button">
                            Add New Book
                        </a>

                    <% } %>

                </div>

            </div>

        </section>


        <!-- Recently Added -->

        <section class="recent-books">

            <div class="recent-books-header">

                <h2>Recently Added</h2>

                <p>
                    A few new stories to explore.
                </p>

            </div>


            <div class="recent-books-grid">

                <% books.forEach(book => { %>

                    <div class="recent-book-card">

                        <% if (book.image) { %>

                            <img
                                src="<%= book.image %>"
                                alt="<%= book.title %> cover"
                                class="recent-book-cover"
                            >

                        <% } else { %>

                            <div class="recent-no-cover">
                                No Cover
                            </div>

                        <% } %>


                        <div class="recent-book-info">

                            <h3>
                                <%= book.title %>
                            </h3>

                            <p>
                                <%= book.author %>
                            </p>

                            <a href="/books/<%= book._id %>">
                                View Book →
                            </a>

                        </div>

                    </div>

                <% }) %>

            </div>


            <div class="browse-all">

                <a href="/books">
                    Browse All Books →
                </a>

            </div>

        </section>

    </main>

    <%- include('./partials/footer.ejs') %>

</body>

</html>